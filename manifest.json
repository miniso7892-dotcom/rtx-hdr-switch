{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.3.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/miniso7892-dotcom/rtx-hdr-switch",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "storage",
    "scripting",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "i18n.js",
        "lib.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html"
      ],
      "matches": [
        "https://bilibili.com/*",
        "https://player.bilibili.com/*",
        "https://twitch.tv/*",
        "https://v.qq.com/*",
        "https://www.bilibili.com/*",
        "https://www.twitch.tv/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "commands": {
    "toggle-hdr": {
      "suggested_key": {
        "default": "Alt+H"
      },
      "description": "__MSG_cmdToggleHdr__"
    },
    "toggle-auto": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "__MSG_cmdToggleAuto__"
    },
    "nv-mg-up": {
      "suggested_key": {
        "default": "Alt+Shift+Up"
      },
      "description": "__MSG_cmdMgUp__"
    },
    "nv-mg-down": {
      "suggested_key": {
        "default": "Alt+Shift+Down"
      },
      "description": "__MSG_cmdMgDown__"
    },
    "forget-video": {
      "description": "__MSG_cmdForgetVideo__"
    },
    "nv-next-preset": {
      "description": "__MSG_cmdNextPreset__"
    },
    "peek": {
      "description": "__MSG_cmdPeek__"
    },
    "next-profile": {
      "description": "__MSG_cmdNextProfile__"
    },
    "nv-undo": {
      "description": "__MSG_cmdNvUndo__"
    }
  }
}
